:[\"\",\"---\",\"\",\"## Phase 22: Fix Bootstrap Recursion — Height Bump in ensure_movie_view_size (2026-06-…","timestamp":"2026-06-12T12:59:48.651Z","title":"hashline_edit","type":"file_edit"},"type":"compressed"},"obs_mqaxovi7_3a0fe42a42f2":{"observation":{"concepts":[],"confidence":0.3,"facts":[],"files":[],"id":"obs_mqaxovi7_3a0fe42a42f2","importance":5,"narrative":"{\"type\":\"fact\",\"content\":\"IPG-MOVIE View is a Tcl array, not a dict. Found via find_view_vars.py using 'array names View'. dict set View(wno) creates a SEPARATE Tcl dict variable independent from the View array. Correct fix uses height bump (View::SetSize h+1 then h) to force SetSize to execute and sync the array.\",\"concepts\":\"Tcl array, View, dict set, height bump, IPG-MOVIE\",\"project\":\"cm141-ca…","sessionId":"ses_1e489f01dffe5ZvKFhGJQKafWF","subtitle":"{\"type\":\"fact\",\"content\":\"IPG-MOVIE View is a Tcl array, not a dict. Found via find_view_vars.py using 'array names Vie…","timestamp":"2026-06-12T13:00:00.508Z","title":"agentmemory_memory_save","type":"subagent"},"type":"compressed"},"obs_mqaxowjo_417d11e5dd31":{"observation":{"concepts":[],"confidence":0.3,"facts":[],"files":[],"id":"obs_mqaxowjo_417d11e5dd31","importance":5,"narrative":"{\"type\":\"fact\",\"content\":\"Minimized window crash fix: When window minimized, $View(ev.view) may return multi-word value (e.g. '0 0'). This causes 'set vno \\\\$View(ev.view)' to fail with 'wrong # args'. Fix: use 'scan \\\\$View(ev.view) %d vno' which extracts just the first integer safely.\",\"concepts\":\"minimized, window, View(ev.view), multi-word, set, scan, Tcl\",\"project\":\"cm141-calibration\",\"files…","sessionId":"ses_1e489f01dffe5ZvKFhGJQKafWF","subtitle":"{\"type\":\"fact\",\"content\":\"Minimized window crash fix: When window minimized, $View(ev.view) may return multi-word value…","timestamp":"2026-06-12T13:00:01.857Z","title":"agentmemory_memory_save","type":"subagent"},"type":"compressed"},"obs_mqaxrdmo_d9fb6007d3f8":{"o