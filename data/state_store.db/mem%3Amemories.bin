aCalibration/)","createdAt":"2026-06-12T09:05:30.905Z","files":["C:/CM_Projects/CMO141_Calibration/Data/Script/CameraCalibration/cmapi_testrun_control.py"],"id":"mem_mqapbbbw_aa27aa7f1744","isLatest":false,"sessionIds":[],"sourceObservationIds":[],"strength":7,"supersedes":[],"title":"Changed cmapi_testrun_control.py (CameraCalibration/)","type":"architecture","updatedAt":"2026-06-12T09:05:30.905Z","version":1},"mem_mqapcmz0_e2b1a6f96011":{"concepts":["IPG-MOVIE","View dict","bootstrap","CheckViewPort","SIM_START","recursion","View::SetSize","no-op"],"content":"Run 5 crash fix: ensure_movie_view_size in cmapi_testrun_control.py now adds dict set View($wno) Width/Height after View::SetSize to force-sync IPG-MOVIE View dict. View::SetSize is a no-op when widget already matches target size, leaving the dict stale with old camera dimensions. When SIM_START fires during bootstrap, IPG-MOVIE's CheckViewPort sees dict height != widget height and enters infinite recursion. The dict set bypasses SetSize's no-op guard.","createdAt":"2026-06-12T09:06:32.650Z","files":["cmapi_testrun_control.py:1778-1779","calibration_orchestrator.py:245-253"],"id":"mem_mqapcmz0_e2b1a6f96011","isLatest":true,"sessionIds":[],"sourceObservationIds":[],"strength":7,"supersedes":[],"title":"Run 5 crash fix: ensure_movie_view_size in cmapi_testrun_control.py now adds dic","type":"bug","updatedAt":"2026-06-12T09:06:32.650Z","version":1},"mem_mqapcwpu_57d298b08daf":{"concepts":["patch","code-change"],"content":"Changed mem%3Ahealth.bin (state_store.db/)","createdAt":"2026-06-12T09:06:45.280Z","files":["C:/CM_Projects/CMO141_Calibration/Data/Script/CameraCalibration/data/state_store.db/mem%3Ahealth.bin"],"id":"mem_mqapcwpu_57d298b08daf","isLatest":false,"parentId":"mem_mqap9rko_945466ba56f4","sessionIds":[],"sourceObservationIds":[],"strength":7,"supersedes":["mem_mqap9rko_945466ba56f4"],"title":"Changed mem%3Ahealth.bin (state_store.db/)","type":"architecture","updatedAt":"2026-06-12T09:06:45.280Z","v