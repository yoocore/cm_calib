meraCalibration/data/stream_store/stream%3Amem-live%3Ases_1e489f01dffe5ZvKFhGJQKafWF.bin","C:/CM_Projects/CMO141_Calibration/Data/Script/CameraCalibration/data/stream_store/stream%3Amem-live%3Aviewer.bin"],"id":"mem_mqaorlc5_6de50fe47418","isLatest":false,"parentId":"mem_mqaojx27_0a017e1c4dce","sessionIds":[],"sourceObservationIds":[],"strength":7,"supersedes":["mem_mqaojx27_0a017e1c4dce"],"title":"Changed 4 files: mem%3Aobs%3Ases_1e489f01dffe5ZvKFhGJQKafWF.bin (state_store.db/","type":"architecture","updatedAt":"2026-06-12T08:50:10.754Z","version":14},"mem_mqaou8ww_223f17a06a9f":{"concepts":[],"content":"Phase 21 (commit 23e4965) changed capture body from height bump (View::SetSize h+1→h) to dict set View($vno). This caused two issues when window minimized then restored: (1) minimized capture fails with Tcl `wrong # args` error on `set` commands; (2) restore+SIM_START triggers CheckViewPort recursion because View dict stale. The fix plan is: revert capture body back to height bump which was validated in Phase 18, add diagnostic logging around View() and cget calls to detect multi-word returns. Bootstrap recursion (Run 5) deferred - only happens with minimize→restore→SIM_START sequence.","createdAt":"2026-06-12T08:52:14.622Z","files":["camera_calibration.py","dde_health_check.py"],"id":"mem_mqaou8ww_223f17a06a9f","isLatest":true,"sessionIds":[],"sourceObservationIds":[],"strength":7,"supersedes":[],"title":"Phase 21 (commit 23e4965) changed capture body from height bump (View::SetSize h","type":"architecture","updatedAt":"2026-06-12T08:52:14.622Z","version":1},"mem_mqaoua8y_61ae8cbb93e7":{"concepts":["patch","code-change"],"content":"Changed mem%3Ahealth.bin (state_store.db/)","createdAt":"2026-06-12T08:52:16.351Z","files":["C:/CM_Projects/CMO141_Calibration/Data/Script/CameraCalibration/data/state_store.db/mem%3Ahealth.bin"],"id":"mem_mqaoua8y_61ae8cbb93e7","isLatest":false,"parentId":"mem_mqaodmh1_8f7a6ff357bc","sessionIds":[],"sourceObservationIds":[],"strength":