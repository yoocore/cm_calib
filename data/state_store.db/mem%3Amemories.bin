vationIds":[],"strength":7,"supersedes":["mem_mqamvn0p_8c1d9a042c01"],"title":"Changed 2 files: mem%3Ahealth.bin (state_store.db/), PROGRESS_HANDOFF.md (projec","type":"architecture","updatedAt":"2026-06-12T12:59:50.209Z","version":2},"mem_mqaxovfl_0c4338ab083b":{"concepts":["Tcl array","View","dict set","height bump","IPG-MOVIE"],"content":"IPG-MOVIE View is a Tcl array, not a dict. Found via find_view_vars.py using 'array names View'. dict set View(wno) creates a SEPARATE Tcl dict variable independent from the View array. Correct fix uses height bump (View::SetSize h+1 then h) to force SetSize to execute and sync the array.","createdAt":"2026-06-12T13:00:00.408Z","files":["find_view_vars.py:29","cmapi_testrun_control.py:1776-1782"],"id":"mem_mqaxovfl_0c4338ab083b","isLatest":true,"sessionIds":[],"sourceObservationIds":[],"strength":7,"supersedes":[],"title":"IPG-MOVIE View is a Tcl array, not a dict. Found via find_view_vars.py using 'ar","type":"fact","updatedAt":"2026-06-12T13:00:00.408Z","version":1},"mem_mqaxowfr_b330fb5a6283":{"concepts":["minimized","window","View(ev.view)","multi-word","set","scan","Tcl"],"content":"Minimized window crash fix: When window minimized, $View(ev.view) may return multi-word value (e.g. '0 0'). This causes 'set vno \\$View(ev.view)' to fail with 'wrong # args'. Fix: use 'scan \\$View(ev.view) %d vno' which extracts just the first integer safely.","createdAt":"2026-06-12T13:00:01.715Z","files":["camera_calibration.py:7767"],"id":"mem_mqaxowfr_b330fb5a6283","isLatest":true,"sessionIds":[],"sourceObservationIds":[],"strength":7,"supersedes":[],"title":"Minimized window crash fix: When window minimized, $View(ev.view) may return mul","type":"fact","updatedAt":"2026-06-12T13:00:01.715Z","version":1},"mem_mqaxoxst_016d98d33ae7":{"concepts":["patch","code-change"],"content":"Changed 5 files: mem%3Amemories.bin (state_store.db/), mem%3Aobs%3Ases_1e489f01dffe5ZvKFhGJQKafWF.bin (state_store.db/), mem%3Asessions.bin (state_store.db/), strea